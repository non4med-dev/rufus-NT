msgid ""
"Another Rufus application is running.\n"
"Please close the first application before running another one."
msgstr ""
"Vykdoma kita Rufus programa.\n"
"Pries vykdydami nauja programa, uzdarykite ankstesniaja."

#. • MSG_003
msgid ""
"WARNING: ALL DATA ON DEVICE '%s' WILL BE DESTROYED.\n"
"To continue with this operation, click OK. To quit click CANCEL."
msgstr ""
"ISPEJIMAS: VISI DUOMENYS IRENGINYJE ,,%s' BUS SUNAIKINTI.\n"
"Noredami testi si veiksma, spauskite Gerai. Noredami iseiti - spauskite Atsaukti."

