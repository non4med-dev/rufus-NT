msgid ""
"Another Rufus application is running.\n"
"Please close the first application before running another one."
msgstr ""
"Ung dung Rufus khac dang chay.\n"
"Vui long dong ung dung dau tien truoc khi chay mot ung dung moi."

#. • MSG_003
msgid ""
"WARNING: ALL DATA ON DEVICE '%s' WILL BE DESTROYED.\n"
"To continue with this operation, click OK. To quit click CANCEL."
msgstr ""
"CANH BAO: TAT CA DU LIEU TREN THIET BI '%s' SE BI XOA.\n"
"De tiep tuc tien trinh nay, nhan OK. De thoat nhan HUY."

